              <property name="styleSheet">
               <string notr="true">QLineEdit{
background-color: #f0f0f0;
border-radius: 8px;
border: none;
font: 63 9pt &quot;Artifakt Element Medium&quot;;
selection-background-color: rgb(255, 230, 156);
selection-color: rgba(120, 220, 220, 255);

}
QLineEdit::placeholder {
    color: #aaaaaa;
}
/* 设置 QMenu 的背景颜色和边框 */
QMenu {
background-color: #f0f0f0;
border-radius: 15px;

}

/* 设置 QMenu 的项样式 */
QMenu::item {
background-color: rgba(120, 220, 220, 255);
padding: 5px 20px;
}

/* 设置鼠标悬停时的样式 */
QMenu::item:selected {
background-color: rgb(255, 230, 156);
color: black;
}

/* 设置分隔符样式 */
QMenu::separator {
height: 1px;

}</string>
