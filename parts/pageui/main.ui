             <widget class="QSlider" name="storage_prog_slider">
              <property name="styleSheet">
               <string notr="true">/* 滑槽的样式 */
QSlider::groove:horizontal {
    border: 1px solid #999999;
    height: 8px; /* 滑槽高度 */
    border-radius: 4px; /* 圆角半径 */
	
	background-color: rgb(166, 94, 255);
}

/* 填充部分的样式 */
QSlider::sub-page:horizontal {
    background: #FFA500; /* 橙色填充 */
    border: 1px solid #999999;
    height: 8px;
    border-radius: 4px;
}

/* 隐藏滑块 */
QSlider::handle:horizontal {
    background: transparent; /* 隐藏滑块 */
    width: 0px; /* 滑块宽度为 0 */
    margin: 0px;
}</string>
