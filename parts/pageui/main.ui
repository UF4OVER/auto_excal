    border: none; /* 无边框 */
    font-size: 16px; /* 字体大小 */
    color: #333; /* 文本颜色 */
font: 63 9pt &quot;Artifakt Element Medium&quot;;
border-radius: 20px;      /* 圆角半径 */
}

/* 鼠标悬停时 */
QPushButton:hover {
    background-color: rgba(106, 178, 255,200); /* 轻微背景色变化 */
    color: #000; /* 文本颜色加深 */
}

/* 按下时 */
QPushButton:pressed {
    background-color:  rgb(106, 178, 255); /* 更深的背景色 */
}</string>
